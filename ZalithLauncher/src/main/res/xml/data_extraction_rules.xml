<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12 (API 31) and higher.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   The launcher database stores account credentials (Microsoft refresh/access
   tokens and third-party auth server passwords). Credentials must never leave
   the device, so the database and its SQLite sidecar files are excluded from
   both cloud backup and device-to-device transfer.
   Keep this list in sync with backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="launcher_data.db" />
        <exclude domain="database" path="launcher_data.db-wal" />
        <exclude domain="database" path="launcher_data.db-shm" />
        <exclude domain="database" path="launcher_data.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="launcher_data.db" />
        <exclude domain="database" path="launcher_data.db-wal" />
        <exclude domain="database" path="launcher_data.db-shm" />
        <exclude domain="database" path="launcher_data.db-journal" />
    </device-transfer>
</data-extraction-rules>
