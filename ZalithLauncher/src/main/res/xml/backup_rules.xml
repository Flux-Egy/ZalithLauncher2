<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for Android 11 (API 30) and lower.
   Android 12+ uses data_extraction_rules.xml instead.
   See https://developer.android.com/guide/topics/data/autobackup

   The launcher database stores account credentials (Microsoft refresh/access
   tokens and third-party auth server passwords). Credentials must never leave
   the device through backups, so the database and its SQLite sidecar files are
   excluded. Users re-authenticate after restoring onto a new device.
   Keep this list in sync with data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="database" path="launcher_data.db" />
    <exclude domain="database" path="launcher_data.db-wal" />
    <exclude domain="database" path="launcher_data.db-shm" />
    <exclude domain="database" path="launcher_data.db-journal" />
</full-backup-content>
